{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "process",
            "command": "make",
            "args": [
                "PLATFORM=PLATFORM_DESKTOP",
                "BUILD_MODE=DEBUG",
                "PROJECT_NAME=EnergyGame"
            ],
            "windows": {
                "command": "mingw32-make.exe",
                "args": [
                    "PLATFORM=PLATFORM_DESKTOP",
                    "RAYLIB_PATH=C:/raylib/raylib",
                    "PROJECT_NAME=EnergyGame",
                    "BUILD_MODE=DEBUG"
                ]
            },
            "osx": {
                "args": [
                    "RAYLIB_PATH=<path_to_raylib>/raylib",
                    "PROJECT_NAME=EnergyGame",
                    "BUILD_MODE=DEBUG"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build release",
            "type": "process",
            "command": "make",
            "args": [
                "PLATFORM=PLATFORM_DESKTOP",
                "PROJECT_NAME=EnergyGame"
            ],
            "windows": {
                "command": "mingw32-make.exe",
                "args": [
                    "PLATFORM=PLATFORM_DESKTOP",
                    "RAYLIB_PATH=C:/raylib/raylib",
                    "PROJECT_NAME=EnergyGame",
                    "BUILD_MODE=RELEASE"
                ]
            },
            "osx": {
                "args": [
                    "RAYLIB_PATH=<path_to_raylib>/raylib",
                    "PROJECT_NAME=EnergyGame",
                    "BUILD_MODE=RELEASE"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}